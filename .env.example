# Copy to .env and fill in. Never commit .env — it is gitignored and the
# pre-commit hook runs gitleaks over staged changes.

# --- Core ---
NODE_ENV=development

# --- Database (Postgres) ---
# The local docker-compose Postgres is published on 5435 to avoid clashing with a
# host PostgreSQL on 5432 and with the other portfolio stacks on 5433/5434.
DATABASE_URL=postgresql://lms:lms@localhost:5435/lms?schema=public
# Direct (unpooled) connection, used only by `prisma migrate`. Locally this is
# the same value; behind a transaction-mode pooler it is the provider's direct
# URL, because migrations cannot run through one.
DIRECT_DATABASE_URL=postgresql://lms:lms@localhost:5435/lms?schema=public

# --- Redis ---
# Rate limiting only. The transcode queue is Postgres (SELECT ... FOR UPDATE
# SKIP LOCKED), so job state stays transactional with the asset row.
REDIS_URL=redis://localhost:6382

# --- API service ---
API_PORT=4000
# Server-to-server base URL.
API_BASE_URL=http://localhost:4000

# --- Web app ---
WEB_PORT=3000
APP_BASE_URL=http://localhost:3000
# Browser-visible API URL. Baked at build time by infra/Dockerfile.web.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Auth ---
# Shared by web (Auth.js session + service-token minting), api (token
# verification) and the media ticket HMAC. Must be >= 16 chars.
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Media pipeline ---
# Where uploads, HLS renditions and certificate PDFs are written. Mount a volume
# here in a container. Nothing under it is ever served statically: every byte
# goes through an authenticated API route.
MEDIA_ROOT=./var/media
# ffmpeg and ffprobe. Left unset they are resolved from PATH, which is what a
# system install gives you. Set them to point at a different build.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# HLS segment length in seconds. Also the keyframe interval, so changing it
# requires re-transcoding for renditions to stay switchable.
HLS_SEGMENT_SECONDS=4
# Hard ceiling on one transcode. A wedged ffmpeg is killed rather than holding
# its job lease forever.
TRANSCODE_TIMEOUT_MS=900000
# Largest accepted upload, in bytes (512 MB).
MAX_UPLOAD_BYTES=536870912

# --- Playback tickets ---
# How long a signed playback ticket stays valid. It is only ever a cheap gate:
# the key endpoint re-reads the enrollment on every fetch, so revoking access
# takes effect on the next segment rather than at expiry.
MEDIA_TICKET_TTL_MINUTES=120

# --- Transcode worker ---
# Identifier written into the job lease and the heartbeat row.
WORKER_ID=worker-1
# How often the worker polls for claimable jobs, in milliseconds.
WORKER_POLL_MS=2000
# Lease length. A job whose lock is older than this is reclaimable, so a worker
# killed mid-transcode does not strand the asset.
JOB_LEASE_SECONDS=1800
# /health reports degraded when no worker has checked in for this long.
WORKER_STALE_SECONDS=120

# --- Completion rules ---
# Share of a video that must be covered before the lesson counts as watched.
# Below 1 because the last seconds are credits and no player reports the final
# frame.
COMPLETION_THRESHOLD=0.9

# --- Email ---
# Local dev uses Mailhog (docker-compose). Leave SMTP_HOST empty to fall back to
# the log channel, which prints instead of sending and never throws.
SMTP_HOST=localhost
SMTP_PORT=1028
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=courses@lms.local

# --- Rate limits (requests per minute, per client IP) ---
# Segments get their own, much larger budget: a ten-minute lesson is ~150
# segment requests plus a key fetch, which the global budget would refuse.
RATE_LIMIT_GLOBAL=120
RATE_LIMIT_AUTH=5
RATE_LIMIT_MEDIA=2000
